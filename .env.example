# Variables del servicio en Railway (ninguna va dentro de la app del navegador)
DATABASE_URL=postgresql://...        # Railway: enlazar a la base Postgres (referencia ${{Postgres.DATABASE_URL}})
BOOTSTRAP_ADMIN_PIN=123456           # solo el primer arranque: crea al administrador. Después se puede borrar
# SESSION_SECRET=                    # opcional; si falta, el servidor genera uno y lo guarda en la base
# PUSH_CONTACT=mailto:tu@correo.com  # opcional, para los avisos push
